{
  "name": "canton-mcp-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "build:localnet": "npm run build && tsc -p demo/localnet/tsconfig.json",
    "start": "node dist/mcp/index.js",
    "client-config": "node dist/mcp/index.js --client-config",
    "payments:localnet": "bash demo/localnet/network.sh",
    "payments:mcp": "node dist/mcp/index.js",
    "payments:review": "node dist/demo/signer/review-action.js",
    "payments:check-privacy": "node dist/demo/setup.js --check-privacy",
    "payments:check": "node dist/demo/check-payments.js --container",
    "actions:review": "node dist/demo/signer/review-action.js",
    "actions:seed-group": "bash demo/localnet/network.sh seed-group",
    "actions:check": "node dist/demo/check-payments.js --container --group",
    "format": "prettier --write \"src/**/*.ts\" \"demo/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"demo/**/*.ts\""
  },
  "dependencies": {
    "@canton-network/core-ledger-proto": "1.17.0",
    "@canton-network/core-tx-hashing": "1.2.0",
    "@canton-network/wallet-sdk": "1.7.0",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.20.5",
    "prettier": "3.8.4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@metamask/utils": {
      "uuid": "11.1.1"
    }
  }
}
