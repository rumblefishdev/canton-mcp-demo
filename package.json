{
  "name": "canton-mcp-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "build:localnet": "npm run build && tsc -p demo/localnet/tsconfig.json",
    "start": "node dist/mcp/index.js",
    "format": "prettier --write \"src/**/*.ts\" \"demo/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"demo/**/*.ts\"",
    "demo": "bash demo/localnet/run-wallet-demo.sh"
  },
  "dependencies": {
    "@canton-network/core-ledger-proto": "1.18.0",
    "@canton-network/core-tx-hashing": "1.3.0",
    "@canton-network/wallet-sdk": "1.7.0",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@metamask/utils": {
      "uuid": "11.1.1"
    }
  }
}
